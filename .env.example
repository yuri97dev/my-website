APP_NAME="Yuri 97"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://yuri97.com

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR
APP_TIMEZONE=America/Manaus

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=nested_daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=my_website
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.yuri97.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=630

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

HTTP_PORT=8080

USER_ID=1000
GROUP_ID=1000

SEEDING_PASSWORD=

TRUSTED_PROXIES=127.0.0.1,::1,172.18.0.1

DOCKER_NETWORK=my-website-internal

OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://ollama-server:11434/api/
OLLAMA_CHAT_MODEL=google_gemma-4-E2B-it
OLLAMA_KEEP_ALIVE=30s

INERTIA_SSR_ENABLED=false

ASSISTANT_ENABLED=true
ASSISTANT_AUTHOR_ID=0
ASSISTANT_STORE_SELECTION_PROMPT=false
ASSISTANT_LAYA_TIMEOUT=90

LAYA_URL=http://laya:8000
LAYA_API_KEY=
